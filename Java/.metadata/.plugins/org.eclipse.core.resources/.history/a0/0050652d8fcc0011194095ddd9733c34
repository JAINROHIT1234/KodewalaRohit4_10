package Day_31_Overriding;


class Login{
	
	
	public void doLogin(String name , int password) {
		
		System.out.println("Login.doLogin()");
		
	}
	
	private String doLogin(String gmail , String password) {
		
		System.out.println("Login.doLogin()");
		
		return"Login successfully";
	}
	
	protected int doLogin(int phoneNo) {
		
		System.out.println("Login.doLogin()");
		
		return phoneNo;
		
	}
	
	
}

public class Overloading_Login {

	public static void main(String[] args) {
		
		Login log = new Login();
		log.doLogin(124526);
		log.doLogin("Rohit", 12453);
		log.doLogin("gmail")
		

	}

}
