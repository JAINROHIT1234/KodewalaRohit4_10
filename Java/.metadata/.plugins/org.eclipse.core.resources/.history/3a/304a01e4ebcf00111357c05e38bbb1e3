package Day_18_If_else;

public class NumberUtility {

	boolean isPrime(int num) {

		boolean isPrime = true;

		for (int i = 1; i <= num; i++) {
			if (num % i == 0) {
				isPrime = false;
			}
			
			

		}
		return isPrime;
	}

	int original;

	int reverse(int num) {

		original = num;

		int rev = 0;

		while (num != 0) {

			int rem = num % 10;

			rev = rev * 10 + rem;

			num = num / 10;

		}

		return rev;

	}

	boolean isPalindrome(int num) {

		boolean isPalindrome = false;

		original = num;

		int rev = 0;

		while (num != 0) {

			int rem = num % 10;

			rev = rev * 10 + rem;

			num = num / 10;

		}

		if (original == rev) {

			isPalindrome = true;

		}

		return isPalindrome;

	}

